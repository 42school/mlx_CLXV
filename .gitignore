# build artifacts
*.o
*.so
*~

# written by a standalone ./configure.sh run, remembers the auto-detected
# or user-picked backend for plain `make` to pick up (see Makefile)
.mlx_config.mk

# copy of the root `version` file, made by `make pypkg` so pyproject.toml
# can read it as its own dynamic version source without escaping the
# python/ project directory
python/version

# generated at build time from the system's wayland-protocols package
src/backend/mlx__wayland_xdg_shell_protocol.h
src/backend/mlx__wayland_xdg_shell_protocol.c
src/backend/mlx__wayland_pointer_warp_protocol.h
src/backend/mlx__wayland_pointer_warp_protocol.c
src/backend/mlx__wayland_constraints_protocol.h
src/backend/mlx__wayland_constraints_protocol.c
src/backend/mlx__wayland_decoration_protocol.h
src/backend/mlx__wayland_decoration_protocol.c
